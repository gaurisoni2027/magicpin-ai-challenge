# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one: openai | anthropic | gemini | deepseek | groq
LLM_PROVIDER=openai

# Your API key for the chosen provider
LLM_API_KEY=your_api_key_here

# Optional: specify exact model. Leave empty for provider default.
# openai default:    gpt-4o-mini
# anthropic default: claude-3-5-haiku-20241022
# gemini default:    gemini-1.5-flash
# deepseek default:  deepseek-chat
# groq default:      llama-3.1-70b-versatile
LLM_MODEL=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0

# ── Team identity (shown in /v1/metadata) ─────────────────────────────────────
TEAM_NAME=Vera-Hybrid
TEAM_MEMBERS=Your Name
CONTACT_EMAIL=your@email.com
